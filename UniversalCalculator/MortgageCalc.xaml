	<Page
    x:Class="Calculator.MortgageCalc"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Page.Resources>
		<Style TargetType="Button">
			<Setter Property="Background" Value="Gray" />
			<Setter Property="Foreground" Value="Black" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="Margin" Value="5" />
			<Setter Property="MinWidth" Value="20" />
			<Setter Property="FontSize" Value="16" />
		</Style>

		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="Black" />
			<Setter Property="FontSize" Value="24" />
			<Setter Property="VerticalAlignment" Value="Bottom" />
			<Setter Property="Margin" Value="4" />
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Height" Value="32" />
			<Setter Property="MinWidth" Value="200" />
			<Setter Property="Margin" Value="4" />
		</Style>
	</Page.Resources>

	<StackPanel Background="DarkGray" Padding="15">
		<!--Begin Title Panel-->
		<StackPanel HorizontalAlignment="Center" Padding="10">
			<TextBlock FontSize="20" FontWeight="Bold" Foreground="Black">Mortgage Calculator</TextBlock>
		</StackPanel>
		<!--End Title Panel-->

		<!--Begin Primary Container Panel-->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

			<!--Begin Left Side Labels-->
			<StackPanel x:Name="leftLabels">
				<StackPanel x:Name="principalBorrowedPanel" HorizontalAlignment="Right">
					<TextBlock x:Name="principalBorrowedTextBlock" VerticalAlignment="Bottom">Principal Borrowed: $</TextBlock>
				</StackPanel>
				<StackPanel x:Name="yearsPanel">
					<TextBlock x:Name="yearsTextBlock" HorizontalAlignment="Right">Years:</TextBlock>
				</StackPanel>
				<StackPanel x:Name="monthsPanel">
					<TextBlock x:Name="monthsTextBlock" HorizontalAlignment="Right">Months:</TextBlock>
				</StackPanel>
				<StackPanel x:Name="annualInterestRatePanel">
					<TextBlock x:Name="annualInterestRateTextBlock" HorizontalAlignment="Right">Annual Interest Rate: %</TextBlock>
				</StackPanel>
				<StackPanel x:Name="monthlyInterestRatePanel">
					<TextBlock x:Name="monthlyInterestRateTextBlock" HorizontalAlignment="Right">Monthly Interest Rate:</TextBlock>
				</StackPanel>
				<StackPanel x:Name="monthlyRepaymentPanel">
					<TextBlock x:Name="monthlyRepaymentTextBlock" HorizontalAlignment="Right">Monthly Repayment:</TextBlock>
				</StackPanel>
			</StackPanel>
			<!--End Left Side Labels-->

			<!--Begin Right Side Input/Output Fields-->
			<StackPanel x:Name="rightFields">
				<StackPanel x:Name="principalBorrowedInputPanel" HorizontalAlignment="Left">
					<TextBox x:Name="principalBorrowedInputBox"></TextBox>
				</StackPanel>
				<StackPanel x:Name="yearsInputPanel" HorizontalAlignment="Left">
					<TextBox x:Name="yearsInputBox"></TextBox>
				</StackPanel>
				<StackPanel x:Name="monthsInputPanel" HorizontalAlignment="Left">
					<TextBox x:Name="monthsInputBox"></TextBox>
				</StackPanel>
				<StackPanel x:Name="annualInterestRateInputPanel" HorizontalAlignment="Left">
					<TextBox x:Name="annualInterestRateInputBox"></TextBox>
				</StackPanel>
				<StackPanel x:Name="monthlyInterestRateInputPanel" HorizontalAlignment="Left">
					<TextBox x:Name="monthlyInterestRateInputBox" IsReadOnly="True"></TextBox>
				</StackPanel>
				<StackPanel x:Name="monthlyRepaymentInputPanel" HorizontalAlignment="Left">
					<TextBox x:Name="monthlyRepaymentInputBox" IsReadOnly="True"></TextBox>
				</StackPanel>

			</StackPanel>
			<!--End Right Side Input Fields-->


		</StackPanel>
		<!--End Primary Container Panel-->

		<!--Begin Command Buttons Panel-->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
			<Button x:Name="calculateButton" Click="calculateButton_Click">Calculate</Button>
			<Button x:Name="exitButton" Click="exitButton_Click">Exit</Button>
		</StackPanel>
		<!--End Command Buttons Panel-->
	</StackPanel>
</Page>
